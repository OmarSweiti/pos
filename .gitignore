# Rust
/target/
**/*.rs.bk

# Node
node_modules/
dist/
*.local
# A repository-local pnpm content-addressable store. check-branch-workflow-policy.rb
# already prunes it as a generated tree; Git never should have been offered it.
.pnpm-store/

# Python policy/test bytecode
__pycache__/
*.py[cod]

# Env & secrets
.env
.env.*
!.env.example

# Registry and package-manager credentials. An .npmrc or a cargo token in history
# is a rotation, not a revert — and each of these is a file a tool writes for you,
# in the repository root, without asking.
.npmrc
.netrc
_netrc
.git-credentials
.cargo/credentials
.cargo/credentials.toml
.docker/config.json

# Databases & artifacts. SQLite writes its sidecars beside the database under
# whichever extension the database itself carries, and journal mode decides the
# suffix — so every (extension, sidecar) pair has to be listed, not just -wal.
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Tauri
apps/terminal/src-tauri/gen/schemas

# Claude Code — machine-local settings (project settings.json IS committed)
.claude/settings.local.json
# Per-developer notes and scratch worktrees. `*.local` above does not cover
# CLAUDE.local.md, which ends in .md.
CLAUDE.local.md
.claude/worktrees/
# Claude's own write-tracking state. Was covered only by a machine-local
# ~/.config/git/ignore, which a fresh clone elsewhere does not have.
.claude/.cc-writes/
