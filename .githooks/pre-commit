#!/usr/bin/env bash
# Inspect the staged index—the content Git will commit—not the working tree.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel) || {
  echo "pre-commit: ERROR — cannot locate the repository root; refusing closed." >&2
  exit 2
}
policy_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

"$policy_root/scripts/run-python.sh" "$policy_root/scripts/check-staged-policy.py"
"$policy_root/scripts/scan-secrets.sh" --staged "$repo_root"
