#!/usr/bin/env bash
# Enforce the shared change-title grammar and repository attribution policy.
set -euo pipefail

msg_file="${1:-}"
[ -n "$msg_file" ] && [ -r "$msg_file" ] || {
  echo "commit-msg: ERROR — Git did not provide a readable message file; refusing closed." >&2
  exit 2
}

git rev-parse --show-toplevel >/dev/null || {
  echo "commit-msg: ERROR — cannot locate the repository root; refusing closed." >&2
  exit 2
}
policy_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

"$policy_root/scripts/run-python.sh" \
  "$policy_root/scripts/check-automation-attribution.py" --message-file "$msg_file"

# Git's own machinery and rebase helpers generate these subjects. Attribution
# was checked first, so a merge/revert cannot smuggle a machine trailer through.
subject=$(sed -e 's/\r$//' "$msg_file" | sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' | sed -n '1p')
case "$subject" in
  Merge\ *|Revert\ *|fixup!*|squash!*|amend!*|"Initial commit") exit 0 ;;
esac

"$policy_root/scripts/validate-change-title.sh" --validate "$subject"
