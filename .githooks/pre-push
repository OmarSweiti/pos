#!/usr/bin/env bash
# Refuse direct/force/deletion pushes to protected branches and prevent assistant
# attribution from reaching any ref. Local hooks are a seatbelt, not server-side
# branch protection; `--no-verify` remains a deliberate bypass.
set -euo pipefail

remote_name="${1:-}"
[ -n "$remote_name" ] || {
  echo "pre-push: ERROR — Git did not supply the destination remote; refusing closed." >&2
  exit 2
}

repo_root=$(git rev-parse --show-toplevel) || {
  echo "pre-push: ERROR — cannot locate the repository root; refusing closed." >&2
  exit 2
}
policy_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
attribution_check="$policy_root/scripts/check-automation-attribution.py"
staged_policy_check="$policy_root/scripts/check-staged-policy.py"


protected='main staging development'
zero='0000000000000000000000000000000000000000'
refuse=0
commits_file=$(mktemp "${TMPDIR:-/tmp}/pos-pre-push.XXXXXX") || {
  echo "pre-push: ERROR — cannot create a temporary file; refusing closed." >&2
  exit 2
}
trap 'rm -f "$commits_file"' EXIT

while IFS=' ' read -r _local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_sha:-}" ] || {
    echo "pre-push: ERROR — Git supplied a malformed ref update; refusing closed." >&2
    refuse=1
    continue
  }
  branch="${remote_ref#refs/heads/}"

  # Check only commits absent from the supplied destination remote. Using Git's
  # first pre-push argument matters when the destination is `upstream`, a fork,
  # or another named remote; hardcoding origin can reject already-published
  # history or overlook the actual destination's state.
  if [ "$local_sha" != "$zero" ]; then
    if ! git rev-list "$local_sha" --not "--remotes=$remote_name" > "$commits_file"; then
      echo "pre-push: ERROR — cannot enumerate commits destined for '$remote_name'; refusing closed." >&2
      refuse=1
      continue
    fi

    # Backstop an accidentally skipped pre-commit — a clean merge, a
    # cherry-pick, a revert and `rebase --continue` all route around it — over
    # exactly the commits this push publishes.
    #
    # This replaced an unconditional whole-history scan, which was not what it
    # sounded like: with no `--log-opts`, gitleaks walks `--all`, so it charged
    # every push for the whole repository AND refused a push because of a token
    # on an unrelated local branch, or in nothing but a `git stash`. Both
    # measured. Refusing to publish clean content over content you are not
    # publishing is noise, and noise is what teaches `--no-verify`.
    #
    # The whole-history alarm is kept where it costs nothing per push:
    # `just secrets` (inside `just pre-push`), ci.yml's `supply-chain` job on
    # every push to a flow branch, and security.yml weekly. If any of those goes
    # away, this trade has to be revisited.
    #
    # `</dev/null` for the reason documented below: a child here would otherwise
    # inherit Git's ref-update list as stdin.
    scan_status=0
    "$policy_root/scripts/scan-secrets.sh" \
      --pushed "$local_sha" "$remote_name" "$repo_root" </dev/null \
      || scan_status=$?
    if [ "$scan_status" -eq 1 ]; then
      echo "pre-push: REFUSED — '$branch' introduces secret-like content."
      refuse=1
    elif [ "$scan_status" -ne 0 ]; then
      echo "pre-push: ERROR — could not scan the pushed commits for secrets; refusing closed." >&2
      refuse=1
    fi

    while IFS= read -r commit_sha; do
      [ -n "$commit_sha" ] || continue
      check_status=0
      "$policy_root/scripts/run-python.sh" \
        "$attribution_check" --git-commit "$commit_sha" >/dev/null 2>&1 \
        || check_status=$?
      [ "$check_status" -eq 0 ] && continue
      if [ "$check_status" -eq 1 ]; then
        echo "pre-push: REFUSED — '$branch' carries assistant attribution in commit $commit_sha."
      else
        echo "pre-push: ERROR — could not inspect commit $commit_sha; refusing closed." >&2
      fi
      refuse=1
    done < "$commits_file"

    # The sensitive-path list and the 2 MB blob cap live in exactly one checker
    # and have no server-side equivalent — check-protected-paths.sh inspects
    # neither a filename class nor a blob size. Git runs `pre-commit` for an
    # ordinary commit and routes around it entirely for a clean merge, a
    # cherry-pick, a revert and `rebase --continue`, which is precisely where
    # conflict resolution authors content nobody has reviewed. So the content
    # rules are applied again here, where every pushed commit is visible at once.
    #
    # One invocation for the whole push: the commit set is already on disk. It is
    # deliberately OUTSIDE the loop above — a child in there inherits
    # "$commits_file" as stdin and eats the remaining SHAs.
    #
    # `</dev/null` is defence in depth, and it is worth being exact about why,
    # because the honest version is the useful one. The checker already refuses to
    # inherit our stdin: its `git()` helper passes DEVNULL and its two plumbing
    # calls are fed with `input=`. So the redirect is not what saves us today —
    # it is what keeps a future change INSIDE the checker from reaching Git's
    # ref-update list, which is still sitting in our stdin. Measured with both
    # layers removed, a ref carrying a `.env` reached the remote with no refusal
    # printed at all; `.githooks/test-hooks.sh` is what actually holds that shut.
    #
    # Its own output is not suppressed: the per-path messages are the only
    # description of what was refused.
    range_status=0
    "$policy_root/scripts/run-python.sh" \
      "$staged_policy_check" --commits-file "$commits_file" </dev/null \
      || range_status=$?
    if [ "$range_status" -eq 1 ]; then
      echo "pre-push: REFUSED — '$branch' introduces a sensitive path or an oversized blob."
      refuse=1
    elif [ "$range_status" -ne 0 ]; then
      echo "pre-push: ERROR — could not inspect the pushed commits; refusing closed." >&2
      refuse=1
    fi
  fi

  # Tags are append-only. Published releases make their associated tags
  # immutable, but drafts do not; refusing every existing-tag update or deletion
  # closes the ordinary local accident path during that vulnerable window. A
  # brand-new tag still proceeds to GitHub, where the release guard validates it.
  case "$remote_ref" in
    refs/tags/*)
      tag_name=${remote_ref#refs/tags/}
      if [ "$remote_sha" != "$zero" ]; then
        if [ "$local_sha" = "$zero" ]; then
          echo "pre-push: REFUSED — deleting existing tag '$tag_name'. Tags are append-only."
        else
          echo "pre-push: REFUSED — moving existing tag '$tag_name'. Create a new version tag instead."
        fi
        refuse=1
        continue
      fi

      # A NEW v* tag is the one flow operation with a permanent cost. release.yml's
      # guard job refuses a lightweight tag, an unverified signature, a bad grammar
      # and a tag that is not the branch head — but it refuses them AFTER the tag
      # exists on GitHub, and repository policy never moves or deletes a release
      # tag. So a server-side rejection spends the version number: the recovery is
      # a second bump through development → staging → main, not a retag. These are
      # the same refusals, applied before the push, where the cost is nothing.
      #
      # Deliberately NOT duplicated here: the four-file version parity check. The
      # guard owns it (Cargo.toml, tauri.conf.json, apps/terminal/package.json and
      # the tag), and a second implementation in shell would be a second source of
      # truth that can disagree with the first.
      case "$tag_name" in
        v*) ;;
        *) continue ;;
      esac

      tag_core='(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)'
      tag_channel=''
      if printf '%s' "$tag_name" | grep -Eq "^v${tag_core}$"; then
        tag_channel=main
      elif printf '%s' "$tag_name" | grep -Eq "^v${tag_core}-(rc|beta)\.[1-9][0-9]*$"; then
        tag_channel=staging
      else
        echo "pre-push: REFUSED — '$tag_name' is not a release tag grammar release.yml accepts."
        echo "  Use vX.Y.Z, vX.Y.Z-rc.N or vX.Y.Z-beta.N, without leading zeroes."
        refuse=1
        continue
      fi

      tag_object_type=$(git cat-file -t "$local_sha" 2>/dev/null) || tag_object_type=''
      if [ "$tag_object_type" != tag ]; then
        echo "pre-push: REFUSED — '$tag_name' is a lightweight tag. Releases require an annotated, signed tag."
        echo "  Create it with: git tag -s $tag_name -m '<message>'"
        refuse=1
        continue
      fi

      # Presence of a signature is locally decidable; whether GitHub will VERIFY it
      # depends on the key uploaded there as a Signing Key, so that stays the
      # guard's call and a local verify failure is reported as a warning below.
      tag_body=$(git cat-file tag "$local_sha" 2>/dev/null) || tag_body=''
      case "$tag_body" in
        *"-----BEGIN PGP SIGNATURE-----"*|*"-----BEGIN SSH SIGNATURE-----"*|*"-----BEGIN SIGNED MESSAGE-----"*) ;;
        *)
          echo "pre-push: REFUSED — '$tag_name' carries no signature. release.yml requires a verified signed tag."
          echo "  Re-create it with: git tag -s $tag_name -m '<message>'"
          refuse=1
          continue ;;
      esac

      tagged_commit=$(git rev-parse --verify --quiet "${local_sha}^{commit}") || tagged_commit=''
      if [ -z "$tagged_commit" ]; then
        echo "pre-push: ERROR — '$tag_name' does not resolve to a commit; refusing closed." >&2
        refuse=1
        continue
      fi

      # The channel comes from the grammar: a plain version releases from main, a
      # prerelease from staging. The guard compares against the GitHub branch head;
      # locally the best available answer is the remote-tracking ref, falling back
      # to the local branch. If neither exists this cannot be judged, so it is
      # skipped with a warning rather than refused on missing information.
      channel_head=$(git rev-parse --verify --quiet "refs/remotes/$remote_name/$tag_channel^{commit}") \
        || channel_head=$(git rev-parse --verify --quiet "refs/heads/$tag_channel^{commit}") \
        || channel_head=''
      if [ -z "$channel_head" ]; then
        echo "pre-push: WARNING — no '$tag_channel' ref locally, so '$tag_name' cannot be checked against its channel head." >&2
      elif [ "$tagged_commit" != "$channel_head" ]; then
        echo "pre-push: REFUSED — '$tag_name' does not point at the '$tag_channel' head."
        echo "  tagged:        $tagged_commit"
        echo "  $tag_channel head: $channel_head"
        echo "  release.yml requires the tag to identify the current head of its channel."
        refuse=1
        continue
      fi

      if ! git verify-tag "$tag_name" >/dev/null 2>&1; then
        echo "pre-push: WARNING — '$tag_name' has a signature that this machine cannot verify." >&2
        echo "  GitHub's verdict is what release.yml reads, so this is not a refusal." >&2
        echo "  For SSH signing, git also needs: git config gpg.ssh.allowedSignersFile <file>" >&2
      fi
      continue
      ;;
  esac

  case " $protected " in *" $branch "*) ;; *) continue ;; esac

  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: REFUSED — deleting '$branch'. That branch is the trunk of the flow."
    refuse=1
    continue
  fi

  if [ "$remote_sha" != "$zero" ]; then
    merge_status=0
    git merge-base --is-ancestor "$remote_sha" "$local_sha" >/dev/null 2>&1 || merge_status=$?
    if [ "$merge_status" -ne 0 ]; then
      if [ "$merge_status" -gt 1 ]; then
        echo "pre-push: ERROR — cannot verify whether '$branch' is fast-forward; refusing closed." >&2
      else
        echo "pre-push: REFUSED — this is a FORCE-push to '$branch'. It would discard published commits."
      fi
      refuse=1
      continue
    fi
  fi

  echo "pre-push: REFUSED — '$branch' takes changes through a pull request, not a direct push."
  case "$branch" in
    development) echo "          Branch from development, then: gh pr create --base development" ;;
    staging)     echo "          Promote with a PR: development → staging (merge commit, not squash)" ;;
    main)        echo "          Promote with a PR: staging → main (merge commit, not squash)" ;;
  esac
  refuse=1
done

if [ "$refuse" -ne 0 ]; then
  echo
  echo "  The flow: feature → development → staging → main"
  echo "  docs/implementation/03-github-workflow.md §2"
  exit 1
fi
