#!/usr/bin/env bash
# Refuse direct/force/deletion pushes to protected branches and prevent assistant
# attribution from reaching any ref. Local hooks are a seatbelt, not server-side
# branch protection; `--no-verify` remains a deliberate bypass.
set -euo pipefail

remote_name="${1:-}"
[ -n "$remote_name" ] || {
  echo "pre-push: ERROR — Git did not supply the destination remote; refusing closed." >&2
  exit 2
}

repo_root=$(git rev-parse --show-toplevel) || {
  echo "pre-push: ERROR — cannot locate the repository root; refusing closed." >&2
  exit 2
}
policy_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
attribution_check="$policy_root/scripts/check-automation-attribution.py"

# Backstop an accidentally skipped pre-commit and scan every reachable commit,
# including commits introduced by merges. CI repeats this server-side.
"$policy_root/scripts/scan-secrets.sh" --history "$repo_root" </dev/null

protected='main staging development'
zero='0000000000000000000000000000000000000000'
refuse=0
commits_file=$(mktemp "${TMPDIR:-/tmp}/pos-pre-push.XXXXXX") || {
  echo "pre-push: ERROR — cannot create a temporary file; refusing closed." >&2
  exit 2
}
trap 'rm -f "$commits_file"' EXIT

while IFS=' ' read -r _local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_sha:-}" ] || {
    echo "pre-push: ERROR — Git supplied a malformed ref update; refusing closed." >&2
    refuse=1
    continue
  }
  branch="${remote_ref#refs/heads/}"

  # Check only commits absent from the supplied destination remote. Using Git's
  # first pre-push argument matters when the destination is `upstream`, a fork,
  # or another named remote; hardcoding origin can reject already-published
  # history or overlook the actual destination's state.
  if [ "$local_sha" != "$zero" ]; then
    if ! git rev-list "$local_sha" --not "--remotes=$remote_name" > "$commits_file"; then
      echo "pre-push: ERROR — cannot enumerate commits destined for '$remote_name'; refusing closed." >&2
      refuse=1
      continue
    fi
    while IFS= read -r commit_sha; do
      [ -n "$commit_sha" ] || continue
      check_status=0
      "$policy_root/scripts/run-python.sh" \
        "$attribution_check" --git-commit "$commit_sha" >/dev/null 2>&1 \
        || check_status=$?
      [ "$check_status" -eq 0 ] && continue
      if [ "$check_status" -eq 1 ]; then
        echo "pre-push: REFUSED — '$branch' carries assistant attribution in commit $commit_sha."
      else
        echo "pre-push: ERROR — could not inspect commit $commit_sha; refusing closed." >&2
      fi
      refuse=1
    done < "$commits_file"
  fi

  # Tags are append-only. Published releases make their associated tags
  # immutable, but drafts do not; refusing every existing-tag update or deletion
  # closes the ordinary local accident path during that vulnerable window. A
  # brand-new tag still proceeds to GitHub, where the release guard validates it.
  case "$remote_ref" in
    refs/tags/*)
      tag_name=${remote_ref#refs/tags/}
      if [ "$remote_sha" != "$zero" ]; then
        if [ "$local_sha" = "$zero" ]; then
          echo "pre-push: REFUSED — deleting existing tag '$tag_name'. Tags are append-only."
        else
          echo "pre-push: REFUSED — moving existing tag '$tag_name'. Create a new version tag instead."
        fi
        refuse=1
      fi
      continue
      ;;
  esac

  case " $protected " in *" $branch "*) ;; *) continue ;; esac

  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: REFUSED — deleting '$branch'. That branch is the trunk of the flow."
    refuse=1
    continue
  fi

  if [ "$remote_sha" != "$zero" ]; then
    merge_status=0
    git merge-base --is-ancestor "$remote_sha" "$local_sha" >/dev/null 2>&1 || merge_status=$?
    if [ "$merge_status" -ne 0 ]; then
      if [ "$merge_status" -gt 1 ]; then
        echo "pre-push: ERROR — cannot verify whether '$branch' is fast-forward; refusing closed." >&2
      else
        echo "pre-push: REFUSED — this is a FORCE-push to '$branch'. It would discard published commits."
      fi
      refuse=1
      continue
    fi
  fi

  echo "pre-push: REFUSED — '$branch' takes changes through a pull request, not a direct push."
  case "$branch" in
    development) echo "          Branch from development, then: gh pr create --base development" ;;
    staging)     echo "          Promote with a PR: development → staging (merge commit, not squash)" ;;
    main)        echo "          Promote with a PR: staging → main (merge commit, not squash)" ;;
  esac
  refuse=1
done

if [ "$refuse" -ne 0 ]; then
  echo
  echo "  The flow: feature → development → staging → main"
  echo "  docs/implementation/03-github-workflow.md §2"
  exit 1
fi
