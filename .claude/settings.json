{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableAllHooks": false,
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(just lint)",
      "Bash(just test)",
      "Bash(just fmt)",
      "Bash(just acyclic)",
      "Bash(just docs-links)",
      "Bash(just verify-schema)",
      "Bash(just guards)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(cargo nextest run:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(pnpm biome ci:*)",
      "Bash(pnpm biome check:*)",
      "Bash(pnpm -r --if-present test)",
      "Bash(./scripts/check-doc-links.sh)",
      "Bash(./scripts/check-domain-acyclic.py)",
      "Bash(./scripts/verify-schema.py:*)",
      "Bash(./scripts/verify-pg-migrations.py:*)",
      "Bash(./.claude/hooks/test-protect-immutable.sh)",
      "Bash(./.claude/hooks/test-docs-links.sh)",
      "Bash(./.githooks/test-hooks.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Edit(/docs/plan/**)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.development.local)",
      "Read(//**/.env.test)",
      "Read(//**/.env.test.local)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.production)",
      "Read(//**/.env.production.local)",
      "Read(//**/*.sqlite)",
      "Read(//**/*.sqlite3)",
      "Read(//**/*.db)",
      "Read(//**/*.db-wal)",
      "Read(//**/*.db-shm)",
      "Read(//**/*.sqlite-wal)",
      "Read(//**/*.sqlite-shm)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.jks)",
      "Read(//**/*.keystore)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/.npmrc)",
      "Read(//**/.netrc)",
      "Read(//**/_netrc)",
      "Read(//**/.git-credentials)",
      "Read(//**/credentials)",
      "Read(//**/credentials.toml)",
      "Read(//**/.docker/config.json)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/op/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.codex/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/1Password/**)",
      "Read(~/Library/Application Support/Bitwarden/**)"
    ]
  },
  "sandbox": {
    "enabled": false,
    "filesystem": {
      "denyWrite": [
        "./docs/plan"
      ]
    }
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|NotebookEdit|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run-python-hook.mjs",
              "--fail-closed",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-immutable.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run-python-hook.mjs",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/docs-links-on-write.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings|local_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run-python-hook.mjs",
              "--fail-closed",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-settings.py"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
